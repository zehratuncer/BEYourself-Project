<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_background"
    android:padding="16dp">

    <!-- Header: App Name & Category Badge -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="BeYourself ✨"
            android:textColor="#60A5FA"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_quote_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Günün Alıntısı"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Quote Body -->
    <TextView
        android:id="@+id/widget_quote_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/widget_header"
        android:layout_above="@+id/widget_quote_author"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:maxLines="3"
        android:text="&quot;Kendine inan, yapabileceklerinin sınırı yoktur.&quot;"
        android:textColor="#F8FAFC"
        android:textSize="15sp"
        android:textStyle="italic" />

    <!-- Author -->
    <TextView
        android:id="@+id/widget_quote_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="end"
        android:text="— BeYourself"
        android:textColor="#94A3B8"
        android:textSize="12sp"
        android:textStyle="normal" />

</RelativeLayout>
